{
  "manifest_version": 3,
  "name": "PopGuard",
  "short_name": "PopGuard",
  "version": "0.2.0",
  "description": "Blocks unwanted pop-ups, cross-domain pop-ups and stray tabs on the sites you turn it on for.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "action": {
    "default_title": "PopGuard",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  }
}
